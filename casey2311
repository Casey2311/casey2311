<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ASUS Inventory & Pricing System</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --bg: #0f172a;
            --surface: #1e293b;
            --surface2: #334155;
            --text: #e2e8f0;
            --text2: #94a3b8;
            --accent: #00d4ff;
            --danger: #ff6b6b;
            --warning: #ffc107;
            --success: #4caf50;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: var(--bg); color: var(--text); display: flex; min-height: 100vh; }
        .sidebar {
            width: 220px; background: var(--surface); padding: 20px;
            position: fixed; top: 0; left: 0; bottom: 0; z-index: 10;
            display: flex; flex-direction: column;
        }
        .sidebar h2 { color: var(--accent); font-size: 18px; margin-bottom: 30px; }
        .sidebar a {
            display: block; color: var(--text2); text-decoration: none;
            padding: 12px 15px; margin: 4px 0; border-radius: 8px; cursor: pointer;
            transition: 0.3s; font-size: 14px;
        }
        .sidebar a:hover, .sidebar a.active { background: var(--surface2); color: var(--accent); }
        .main { margin-left: 220px; padding: 30px; width: 100%; }
        .page { display: none; }
        .page.active { display: block; }
        .header { margin-bottom: 25px; }
        .header h1 { font-size: 26px; color: var(--text); }
        .header p { color: var(--text2); margin-top: 5px; }
        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 25px; }
        .card {
            background: var(--surface); padding: 20px; border-radius: 12px;
            border-top: 4px solid var(--accent); text-align: center;
        }
        .card h3 { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--text2); }
        .card .value { font-size: 28px; font-weight: bold; color: var(--text); margin: 8px 0; }
        .card .sub { font-size: 12px; color: var(--text2); }
        .section {
            background: var(--surface); padding: 25px; border-radius: 12px;
            margin-bottom: 25px;
        }
        .section h2 { font-size: 18px; margin-bottom: 15px; color: var(--accent); }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { background: var(--surface2); padding: 10px; text-align: left; color: var(--text2); }
        td { padding: 8px 10px; border-bottom: 1px solid var(--surface2); }
        tr:hover { background: rgba(255,255,255,0.03); }
        .badge { padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; }
        .badge.mb { background: #1e3a5f; color: #64b5f6; }
        .badge.vga { background: #5f1e1e; color: #ef5350; }
        .badge.low { background: #5f4c00; color: #ffc107; }
        .badge.out { background: #5f1e1e; color: #ef5350; }
        button, .btn {
            background: var(--accent); color: #0f172a; border: none; padding: 10px 18px;
            border-radius: 8px; cursor: pointer; font-weight: 600; transition: 0.3s;
        }
        button:hover { opacity: 0.85; }
        button.danger { background: var(--danger); color: white; }
        button.success { background: var(--success); color: white; }
        input, select {
            background: var(--surface2); border: 1px solid #475569; color: var(--text);
            padding: 10px; border-radius: 8px; width: 100%; margin-bottom: 10px;
        }
        input:focus, select:focus { border-color: var(--accent); outline: none; }
        .form-row { display: flex; gap: 15px; flex-wrap: wrap; }
        .form-row > * { flex: 1; min-width: 150px; }
        .chart-container { position: relative; height: 300px; width: 100%; margin: 20px 0; }
        .toast { position: fixed; bottom: 20px; right: 20px; background: var(--accent); color: #000; padding: 12px 20px; border-radius: 8px; font-weight: bold; z-index: 999; }
        @media (max-width: 768px) {
            .sidebar { width: 60px; padding: 10px; }
            .sidebar h2 { display: none; }
            .sidebar a { padding: 10px; text-align: center; font-size: 12px; }
            .main { margin-left: 60px; padding: 15px; }
        }
    </style>
</head>
<body>
<div class="sidebar">
    <h2>📊 ASUS System</h2>
    <a onclick="switchPage('dashboard')" class="active" id="nav-dashboard">🏠 Dashboard</a>
    <a onclick="switchPage('inventory')" id="nav-inventory">📦 Inventory Upload</a>
    <a onclick="switchPage('pricelist')" id="nav-pricelist">💰 Price List Upload</a>
    <a onclick="switchPage('fxrate')" id="nav-fxrate">💱 FX Rate</a>
    <a onclick="switchPage('rebates')" id="nav-rebates">🏷️ Rebates</a>
    <a onclick="switchPage('products')" id="nav-products">📋 Products</a>
    <a onclick="switchPage('backup')" id="nav-backup">💾 Backup</a>
</div>

<div class="main" id="mainContent"></div>
<div id="toast" class="toast" style="display:none;"></div>

<script>
// ==================== DATA LAYER ====================
const STORAGE_KEYS = {
    products: 'asus_products',
    dailyLogs: 'asus_dailylogs',
    priceList: 'asus_pricelist',
    fxRate: 'asus_fxrate',
    rebates: 'asus_rebates'
};

function loadData(key) {
    const raw = localStorage.getItem(key);
    return raw ? JSON.parse(raw) : [];
}
function saveData(key, data) {
    localStorage.setItem(key, JSON.stringify(data));
    showToast('Data saved ✓');
}

// Initialize sample data if empty
function initSampleData() {
    if (!localStorage.getItem(STORAGE_KEYS.products)) {
        const sampleProducts = [
            { itemCode: 'ASUS-B650M-AYW-WIFI', description: 'B650M AYW WIFI (90MB1KIO-MOUAYO)' },
            { itemCode: 'ASUS-B850M-AYW-GAMING-WIFI', description: 'B850M AYW GAMING WIFI (90MB1LW0-M0UAY0)' },
            { itemCode: 'ASUS-DUAL-RTX5060-O8G', description: 'DUAL RTX5060 O8G (90YVON12-MONA00)' },
            { itemCode: 'ASUS-DUAL-RX7600-O8G-EVO', description: 'DUAL RX7600 O8G EVO (90YVOLDO-MONAOO)' },
            { itemCode: 'ASUS-PRIME-A520M-K/CSM', description: 'PRIME A520M-K CSM (90MB1500-MOUAYC)' }
        ];
        saveData(STORAGE_KEYS.products, sampleProducts);
        saveData(STORAGE_KEYS.fxRate, 3.908);
    }
}

function getProducts() { return loadData(STORAGE_KEYS.products); }
function getDailyLogs() { return loadData(STORAGE_KEYS.dailyLogs); }
function getPriceList() { return loadData(STORAGE_KEYS.priceList); }
function getFxRate() { const v = localStorage.getItem(STORAGE_KEYS.fxRate); return v ? parseFloat(v) : 0; }
function getRebates() { return loadData(STORAGE_KEYS.rebates); }

// Latest data per product (merged)
function getInventorySnapshot() {
    const products = getProducts();
    const logs = getDailyLogs();
    const priceList = getPriceList();
    const rebates = getRebates();
    const fx = getFxRate();
    const result = [];
    products.forEach(p => {
        const productLogs = logs.filter(l => l.itemCode === p.itemCode).sort((a,b) => new Date(b.date) - new Date(a.date));
        const latest = productLogs[0] || {};
        const priceInfo = priceList.find(pl => pl.itemCode === p.itemCode) || {};
        const fob = priceInfo.fobUsd || 0;
        const sdp = priceInfo.sdp || 0;
        const finalLanding = (fob * 1.03 * fx) * 1.051;
        const normalMargin = 0.05;
        const agpMargin = 0.03;
        const normalBest = Math.round((finalLanding / (1 - normalMargin)) / 5) * 5;
        const agpBest = Math.round((finalLanding / (1 - agpMargin)) / 5) * 5;
        const rebateSum = rebates.filter(r => r.itemCode === p.itemCode).reduce((s, r) => s + (r.amount || 0), 0);
        const billingPrice = agpBest + rebateSum;
        result.push({
            ...p,
            qty: latest.qty || 0,
            systemCost: latest.systemCost || 0,
            fobUsd: fob,
            sdp: sdp,
            finalLandingCost: finalLanding,
            normalBestPrice: normalBest,
            agpBestPrice: agpBest,
            billingPrice: billingPrice,
            lastUpdate: latest.date || null
        });
    });
    return result;
}

// ==================== UI HELPERS ====================
function showToast(msg, duration=2000) {
    const t = document.getElementById('toast');
    t.textContent = msg; t.style.display = 'block';
    setTimeout(() => t.style.display = 'none', duration);
}

function switchPage(page) {
    document.querySelectorAll('.sidebar a').forEach(a => a.classList.remove('active'));
    document.getElementById(`nav-${page}`).classList.add('active');
    renderPage(page);
}

function formatCurrency(val) { return 'RM ' + Number(val).toFixed(2); }
function formatDate(d) { return d ? new Date(d).toLocaleDateString('en-MY') : '-'; }

// ==================== RENDER PAGES ====================
async function renderPage(page) {
    const main = document.getElementById('mainContent');
    switch(page) {
        case 'dashboard': main.innerHTML = await dashboardPage(); initDashboardCharts(); break;
        case 'inventory': main.innerHTML = inventoryPage(); break;
        case 'pricelist': main.innerHTML = priceListPage(); break;
        case 'fxrate': main.innerHTML = fxRatePage(); break;
        case 'rebates': main.innerHTML = rebatesPage(); loadRebatesTable(); break;
        case 'products': main.innerHTML = productsPage(); loadProductsTable(); break;
        case 'backup': main.innerHTML = backupPage(); break;
    }
}

// ==================== DASHBOARD ====================
function dashboardPage() {
    const snap = getInventorySnapshot();
    const mb = snap.filter(p => p.itemCode.startsWith('ASUS-') && (p.description.includes('MB') || p.itemCode.includes('MB') || p.itemCode.includes('B650') || p.itemCode.includes('B850') || p.itemCode.includes('X870') || p.itemCode.includes('PRIME') || p.itemCode.includes('TUF') || p.itemCode.includes('ROG'))); 
    // Simple categorization: check if item code contains known MB indicators or we can use a category field. Better: we should store category in product master. Since we don't have explicit category, I'll use a heuristic: if itemCode contains 'MB' or certain patterns. But user said they want MB vs VGA. I'll add a 'category' field to product master. For now, I'll use a quick function:
    const categorize = (code) => code.includes('MB') || code.includes('B650') || code.includes('B850') || code.includes('X870') || code.includes('PRIME') || code.includes('TUF') || code.includes('ROG') || code.includes('PROART') || code.includes('PRO-WS') ? 'MB' : 'VGA';
    const mbItems = snap.filter(p => categorize(p.itemCode) === 'MB');
    const vgaItems = snap.filter(p => categorize(p.itemCode) === 'VGA');
    const totalMbQty = mbItems.reduce((s,i) => s + i.qty, 0);
    const totalVgaQty = vgaItems.reduce((s,i) => s + i.qty, 0);
    const totalValue = snap.reduce((s,i) => s + (i.qty * i.systemCost), 0);
    const lowStock = snap.filter(i => i.qty > 0 && i.qty < 10);
    const outOfStock = snap.filter(i => i.qty === 0);
    const logs = getDailyLogs();
    const lastUpdate = logs.length ? logs.reduce((a,b) => a.date > b.date ? a : b).date : 'No data';
    const daysSince = lastUpdate !== 'No data' ? Math.floor((new Date() - new Date(lastUpdate)) / (1000*60*60*24)) : '-';

    return `
    <div class="header"><h1>📊 ASUS Inventory Dashboard</h1><p>Last updated: ${formatDate(lastUpdate)} (${daysSince} days ago)</p></div>
    <div class="cards">
        <div class="card"><h3>MB Stock</h3><div class="value">${totalMbQty}</div><div class="sub">${mbItems.length} items</div></div>
        <div class="card"><h3>VGA Stock</h3><div class="value">${totalVgaQty}</div><div class="sub">${vgaItems.length} items</div></div>
        <div class="card"><h3>Total Value</h3><div class="value">${formatCurrency(totalValue)}</div></div>
        <div class="card"><h3>⚠️ Alerts</h3><div class="value">${lowStock.length + outOfStock.length}</div><div class="sub">Low: ${lowStock.length}, Out: ${outOfStock.length}</div></div>
    </div>
    <div class="section">
        <h2>📈 Stock by Category</h2>
        <div class="chart-container"><canvas id="stockBarChart"></canvas></div>
    </div>
    <div class="section" style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
        <div><h2>💰 Inventory Value Distribution</h2><div class="chart-container"><canvas id="valuePieChart"></canvas></div></div>
        <div><h2>📉 Cost Trend (Select Product)</h2>
            <select id="trendProduct" onchange="updateTrendChart()">
                ${snap.map(p => `<option value="${p.itemCode}">${p.description}</option>`).join('')}
            </select>
            <div class="chart-container"><canvas id="trendLineChart"></canvas></div>
        </div>
    </div>
    <div class="section">
        <h2>📋 Recent Changes & Alerts</h2>
        <table><thead><tr><th>Product</th><th>QTY</th><th>Cost</th><th>Status</th></tr></thead><tbody>
        ${snap.map(i => {
            const status = i.qty === 0 ? '<span class="badge out">Out</span>' : i.qty < 10 ? '<span class="badge low">Low</span>' : '<span class="badge ' + categorize(i.itemCode).toLowerCase() + '">OK</span>';
            return `<tr><td>${i.itemCode}</td><td>${i.qty}</td><td>${formatCurrency(i.systemCost)}</td><td>${status}</td></tr>`;
        }).join('')}
        </tbody></table>
    </div>`;
}

function initDashboardCharts() {
    const snap = getInventorySnapshot();
    const categorize = (code) => code.includes('MB') || code.includes('B650') || code.includes('B850') || code.includes('X870') || code.includes('PRIME') || code.includes('TUF') || code.includes('ROG') || code.includes('PROART') || code.includes('PRO-WS') ? 'MB' : 'VGA';
    const mbQty = snap.filter(p => categorize(p.itemCode)==='MB').reduce((s,i)=>s+i.qty,0);
    const vgaQty = snap.filter(p => categorize(p.itemCode)==='VGA').reduce((s,i)=>s+i.qty,0);
    // Bar chart
    new Chart(document.getElementById('stockBarChart'), {
        type: 'bar', data: { labels: ['MB', 'VGA'], datasets: [{ label: 'QTY', data: [mbQty, vgaQty], backgroundColor: ['#00d4ff', '#ff6b6b'] }] },
        options: { responsive: true, maintainAspectRatio: false }
    });
    // Pie chart
    const mbValue = snap.filter(p => categorize(p.itemCode)==='MB').reduce((s,i)=>s+(i.qty*i.systemCost),0);
    const vgaValue = snap.filter(p => categorize(p.itemCode)==='VGA').reduce((s,i)=>s+(i.qty*i.systemCost),0);
    new Chart(document.getElementById('valuePieChart'), {
        type: 'pie', data: { labels: ['MB Value', 'VGA Value'], datasets: [{ data: [mbValue, vgaValue], backgroundColor: ['#00d4ff', '#ff6b6b'] }] },
        options: { responsive: true, maintainAspectRatio: false }
    });
    // Line chart for first product
    updateTrendChart();
}

function updateTrendChart() {
    const itemCode = document.getElementById('trendProduct')?.value;
    if (!itemCode) return;
    const logs = getDailyLogs().filter(l => l.itemCode === itemCode).sort((a,b) => new Date(a.date) - new Date(b.date));
    const dates = logs.map(l => l.date);
    const costs = logs.map(l => l.systemCost);
    const ctx = document.getElementById('trendLineChart');
    if (ctx.chart) ctx.chart.destroy();
    ctx.chart = new Chart(ctx, {
        type: 'line', data: { labels: dates, datasets: [{ label: 'System Cost (RM)', data: costs, borderColor: '#00d4ff' }] },
        options: { responsive: true, maintainAspectRatio: false }
    });
}

// ==================== INVENTORY UPLOAD ====================
function inventoryPage() {
    return `
    <div class="header"><h1>📦 Daily Inventory Upload</h1></div>
    <div class="section">
        <h2>Upload CSV</h2>
        <p>Format: Date, Item Code, Description, QTY, System Cost</p>
        <input type="file" id="invFile" accept=".csv" onchange="parseInventoryCSV()">
        <div id="invPreview" style="margin-top:15px;"></div>
    </div>`;
}

function parseInventoryCSV() {
    const file = document.getElementById('invFile').files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const lines = e.target.result.split('\n').filter(l => l.trim());
        const newLogs = [];
        for (let i = 1; i < lines.length; i++) { // skip header
            const parts = lines[i].split(',');
            if (parts.length >= 5) {
                newLogs.push({
                    date: parts[0].trim(),
                    itemCode: parts[1].trim(),
                    description: parts[2].trim(),
                    qty: parseInt(parts[3]) || 0,
                    systemCost: parseFloat(parts[4]) || 0
                });
            }
        }
        // Append to existing logs (avoid duplicates? just append)
        const logs = getDailyLogs();
        logs.push(...newLogs);
        saveData(STORAGE_KEYS.dailyLogs, logs);
        showPreview(newLogs);
        showToast(`Imported ${newLogs.length} entries!`);
    };
    reader.readAsText(file);
}

function showPreview(logs) {
    const div = document.getElementById('invPreview');
    div.innerHTML = logs.length ? `<table><tr><th>Date</th><th>Item Code</th><th>QTY</th><th>System Cost</th></tr>` +
        logs.map(l => `<tr><td>${l.date}</td><td>${l.itemCode}</td><td>${l.qty}</td><td>${formatCurrency(l.systemCost)}</td></tr>`).join('') + '</table>' : '';
}

// ==================== PRICE LIST UPLOAD ====================
function priceListPage() {
    return `
    <div class="header"><h1>💰 ASUS Price List Upload</h1></div>
    <div class="section">
        <h2>Upload CSV (Item Code, FOB USD, SDP)</h2>
        <input type="file" id="plFile" accept=".csv" onchange="parsePriceListCSV()">
        <div id="plPreview" style="margin-top:15px;"></div>
    </div>`;
}

function parsePriceListCSV() {
    const file = document.getElementById('plFile').files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const lines = e.target.result.split('\n').filter(l => l.trim());
        const newPrices = [];
        for (let i = 1; i < lines.length; i++) {
            const parts = lines[i].split(',');
            if (parts.length >= 3) {
                newPrices.push({
                    itemCode: parts[0].trim(),
                    fobUsd: parseFloat(parts[1]) || 0,
                    sdp: parseFloat(parts[2]) || 0
                });
                // Also add/update product master
                const products = getProducts();
                if (!products.find(p => p.itemCode === parts[0].trim())) {
                    products.push({ itemCode: parts[0].trim(), description: parts[0].trim() }); // description not provided, placeholder
                    saveData(STORAGE_KEYS.products, products);
                }
            }
        }
        const currentList = getPriceList();
        // merge by itemCode
        newPrices.forEach(np => {
            const existing = currentList.findIndex(p => p.itemCode === np.itemCode);
            if (existing >= 0) currentList[existing] = np;
            else currentList.push(np);
        });
        saveData(STORAGE_KEYS.priceList, currentList);
        document.getElementById('plPreview').innerHTML = `<p>Imported/Updated ${newPrices.length} items.</p>`;
        showToast('Price list updated!');
    };
    reader.readAsText(file);
}

// ==================== FX RATE ====================
function fxRatePage() {
    const current = getFxRate();
    return `
    <div class="header"><h1>💱 Foreign Exchange Rate</h1></div>
    <div class="section">
        <label>USD/MYR Rate (from BNM)</label>
        <input type="number" id="fxInput" value="${current}" step="0.001">
        <button onclick="updateFxRate()">Save Rate</button>
    </div>`;
}
function updateFxRate() {
    const val = parseFloat(document.getElementById('fxInput').value);
    if (isNaN(val)) return alert('Invalid rate');
    saveData(STORAGE_KEYS.fxRate, val);
    showToast('FX Rate saved!');
}

// ==================== REBATES ====================
function rebatesPage() {
    return `
    <div class="header"><h1>🏷️ Rebate Management</h1></div>
    <div class="section">
        <h2>Add/Edit Rebate</h2>
        <div class="form-row">
            <input type="text" id="rebCaseId" placeholder="Case ID">
            <select id="rebProduct"><option value="">All Products</option></select>
            <input type="number" id="rebAmount" placeholder="Amount (negative RM)" step="0.01">
            <button onclick="addRebate()">Add</button>
        </div>
        <table id="rebatesTable"><thead><tr><th>Case ID</th><th>Product</th><th>Amount</th><th>Action</th></tr></thead><tbody></tbody></table>
    </div>`;
}

function loadRebatesTable() {
    const rebates = getRebates();
    const products = getProducts();
    const productSelect = document.getElementById('rebProduct');
    productSelect.innerHTML = '<option value="">All Products</option>' + products.map(p => `<option value="${p.itemCode}">${p.itemCode}</option>`).join('');
    const tbody = document.querySelector('#rebatesTable tbody');
    tbody.innerHTML = rebates.map((r, idx) => `
        <tr>
            <td>${r.caseId}</td><td>${r.itemCode || 'All'}</td><td>${r.amount}</td>
            <td><button class="danger" onclick="deleteRebate(${idx})">Delete</button></td>
        </tr>`).join('');
}

function addRebate() {
    const caseId = document.getElementById('rebCaseId').value.trim();
    const itemCode = document.getElementById('rebProduct').value;
    const amount = parseFloat(document.getElementById('rebAmount').value);
    if (!caseId || isNaN(amount)) return alert('Fill all fields');
    const rebates = getRebates();
    rebates.push({ caseId, itemCode, amount });
    saveData(STORAGE_KEYS.rebates, rebates);
    loadRebatesTable();
}

function deleteRebate(idx) {
    const rebates = getRebates();
    rebates.splice(idx, 1);
    saveData(STORAGE_KEYS.rebates, rebates);
    loadRebatesTable();
}

// ==================== PRODUCTS ====================
function productsPage() {
    return `
    <div class="header"><h1>📋 Product Master</h1></div>
    <div class="section">
        <button onclick="addProductRow()">+ Add Product</button>
        <table id="productsTable"><thead><tr><th>Item Code</th><th>Description</th><th>Action</th></tr></thead><tbody></tbody></table>
    </div>`;
}
function loadProductsTable() {
    const products = getProducts();
    const tbody = document.querySelector('#productsTable tbody');
    tbody.innerHTML = products.map((p, idx) => `<tr>
        <td>${p.itemCode}</td><td contenteditable="true" onblur="updateProductDesc(${idx}, this.textContent)">${p.description}</td>
        <td><button class="danger" onclick="deleteProduct(${idx})">Del</button></td>
    </tr>`).join('');
}
function addProductRow() {
    const products = getProducts();
    products.push({ itemCode: 'NEW-CODE', description: 'New Product' });
    saveData(STORAGE_KEYS.products, products);
    loadProductsTable();
}
function updateProductDesc(idx, newDesc) {
    const products = getProducts();
    products[idx].description = newDesc;
    saveData(STORAGE_KEYS.products, products);
}
function deleteProduct(idx) {
    const products = getProducts();
    products.splice(idx, 1);
    saveData(STORAGE_KEYS.products, products);
    loadProductsTable();
}

// ==================== BACKUP ====================
function backupPage() {
    return `
    <div class="header"><h1>💾 Backup & Restore</h1></div>
    <div class="section">
        <button onclick="exportBackup()">📥 Export All Data (JSON)</button>
        <br><br>
        <label>Import Backup File:</label>
        <input type="file" id="backupFile" accept=".json" onchange="importBackup()">
    </div>`;
}
function exportBackup() {
    const data = {
        products: getProducts(),
        dailyLogs: getDailyLogs(),
        priceList: getPriceList(),
        fxRate: getFxRate(),
        rebates: getRebates()
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], {type: 'application/json'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'asus_backup.json';
    a.click();
}
function importBackup() {
    const file = document.getElementById('backupFile').files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const data = JSON.parse(e.target.result);
            Object.keys(data).forEach(key => {
                if (key === 'fxRate') {
                    saveData(STORAGE_KEYS.fxRate, data.fxRate);
                } else if (STORAGE_KEYS[key]) {
                    saveData(STORAGE_KEYS[key], data[key]);
                }
            });
            showToast('Backup restored! Reloading...');
            setTimeout(() => location.reload(), 1500);
        } catch(ex) { alert('Invalid backup file'); }
    };
    reader.readAsText(file);
}

